{
  "firestore": {
    "rules": "firestore.rules"
  },

  "database": {
    "rules": "database.rules.json"
  },

  "hosting": {
    "public": "public/dist/sublyon/browser",

    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}