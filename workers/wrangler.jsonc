{
  "name": "m2gdp-g3-log-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",

  /*
   * Valeurs publiques (pas de secret) :
   * projet Firebase pour vérifier les jetons,
   * Realtime Database (participants d'une conversation)
   * et origines autorisées (CORS).
   */
  "vars": {
    "FIREBASE_PROJECT_ID": "m2gdp-g3-log-3963b",
    "FIREBASE_DATABASE_URL": "https://m2gdp-g3-log-3963b-default-rtdb.europe-west1.firebasedatabase.app",
    "ALLOWED_ORIGINS": "http://localhost:4200,http://127.0.0.1:4200,https://m2gdp-g3-log-3963b.web.app,https://m2gdp-g3-log-3963b.firebaseapp.com"
  },

  "d1_databases": [
    {
      "binding": "sublyon_sessions",
      "database_name": "sublyon-sessions",
      "database_id": "7c445009-ec95-4999-bfc0-38cf2cfb901d"
    }
  ],

  "r2_buckets": [
    {
      "binding": "sublyon_media",
      "bucket_name": "sublyon-media"
    }
  ]
}