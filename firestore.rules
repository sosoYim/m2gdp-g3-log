rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, update:
        if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }

    match /bookingRequests/{requestId} {

      allow create:
        if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.listingId is string
        && request.resource.data.ownerName is string
        && request.resource.data.arrivalDate is string
        && request.resource.data.departureDate is string
        && request.resource.data.message is string;

      allow read:
        if request.auth != null
        && resource.data.requesterId == request.auth.uid;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}