rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /*
     * =========================================
     * UTILISATEURS
     * =========================================
     */
    match /users/{userId} {

      allow read, create, update:
        if request.auth != null
        && request.auth.uid == userId;

      allow delete:
        if false;
    }


    /*
     * =========================================
     * PROFIL PUBLIC
     * =========================================
     *
     * Prénom + initiale du nom, lisibles par
     * tout utilisateur connecté (ex. l'annonceur
     * voit le nom du demandeur). Pas d'e-mail.
     */
    match /publicProfiles/{userId} {

      allow read:
        if request.auth != null;

      allow create, update:
        if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['firstName', 'lastInitial', 'updatedAt'])
        && request.resource.data.firstName is string
        && request.resource.data.lastInitial is string
        && request.resource.data.lastInitial.size() <= 1;

      allow delete:
        if false;
    }


    /*
     * =========================================
     * FAVORIS D'UN UTILISATEUR
     * =========================================
     */
    match /users/{userId}/favorites/{favoriteId} {

      allow read:
        if request.auth != null
        && request.auth.uid == userId;


      allow create, update:
        if request.auth != null
        && request.auth.uid == userId

        && request.resource.data.listingId is string
        && request.resource.data.title is string
        && request.resource.data.location is string
        && request.resource.data.details is string
        && request.resource.data.price is number
        && request.resource.data.rating is number
        && request.resource.data.image is string;


      allow delete:
        if request.auth != null
        && request.auth.uid == userId;
    }


    /*
     * =========================================
     * DEMANDES DE RÉSERVATION
     * =========================================
     */
    match /bookingRequests/{requestId} {

      allow create:
        if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.listingId is string
        && request.resource.data.ownerName is string
        && request.resource.data.arrivalDate is string
        && request.resource.data.departureDate is string
        && request.resource.data.message is string;


      /*
       * Lecture par le demandeur
       * ou par l'annonceur concerné.
       */
      allow read:
        if request.auth != null
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );


      /*
       * Le demandeur modifie les dates de
       * sa demande, tant qu'elle est en attente.
       */
      allow update:
        if request.auth != null
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arrivalDate', 'departureDate', 'updatedAt'])
        && request.resource.data.arrivalDate is string
        && request.resource.data.departureDate is string
        && request.resource.data.arrivalDate < request.resource.data.departureDate;


      /*
       * Annulation d'un séjour confirmé :
       * annonceur seulement.
       */
      allow update:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'accepted'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'updatedAt']);


      /*
       * L'annonceur accepte ou refuse une
       * demande en attente (statut + motif de refus).
       */
      allow update:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'rejectionReason'])
        && (
          !('rejectionReason' in request.resource.data)
          || (
            request.resource.data.status == 'rejected'
            && request.resource.data.rejectionReason in ['dates_unavailable', 'already_booked', 'other']
          )
        );

      allow delete:
        if false;
    }


    /*
     * =========================================
     * LOGEMENTS / ANNONCES
     * =========================================
     *
     * - tout le monde peut lire les annonces
     * - l'annonceur gère uniquement
     *   ses propres annonces
     */
    match /listings/{listingId} {

      allow read:
        if true;

      /*
       * L'annonceur crée uniquement
       * des annonces à son nom.
       */
      allow create:
        if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;


      /*
       * L'annonceur peut modifier (pause,
       * remise en ligne) ou supprimer
       * ses propres annonces.
       */
      allow update:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }


    /*
     * =========================================
     * ADRESSE EXACTE D'UNE ANNONCE (PRIVÉE)
     * =========================================
     *
     * listings/{id}/private/address
     * Lecture / écriture : l'annonceur seulement.
     */
    match /listings/{listingId}/private/{docId} {

      allow read, write:
        if request.auth != null
        && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid;
    }


    /*
     * =========================================
     * SÉJOURS CONFIRMÉS (DATES BLOQUÉES)
     * =========================================
     *
     * bookedPeriods/{requestId}, lisible par tous.
     * Créé par l'annonceur pour une demande
     * acceptée (mêmes dates), supprimé par
     * l'annonceur une fois le séjour annulé.
     */
    match /bookedPeriods/{requestId} {

      allow read:
        if true;

      allow create:
        if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/bookingRequests/$(requestId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/bookingRequests/$(requestId)).data.status == 'accepted'
        && request.resource.data.requesterId == get(/databases/$(database)/documents/bookingRequests/$(requestId)).data.requesterId
        && request.resource.data.listingId == get(/databases/$(database)/documents/bookingRequests/$(requestId)).data.listingId
        && request.resource.data.from == get(/databases/$(database)/documents/bookingRequests/$(requestId)).data.arrivalDate
        && request.resource.data.to == get(/databases/$(database)/documents/bookingRequests/$(requestId)).data.departureDate;

      allow delete:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/bookingRequests/$(requestId)).data.status == 'cancelled';

      allow update:
        if false;
    }


    /*
     * =========================================
     * TOUT LE RESTE INTERDIT
     * =========================================
     */
    match /{document=**} {

      allow read, write:
        if false;
    }

  }

}