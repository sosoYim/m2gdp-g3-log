rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /*
     * =========================================
     * UTILISATEURS
     * =========================================
     */
    match /users/{userId} {

      allow read, create, update:
        if request.auth != null
        && request.auth.uid == userId;

      allow delete:
        if false;
    }


    /*
     * =========================================
     * FAVORIS D'UN UTILISATEUR
     * =========================================
     */
    match /users/{userId}/favorites/{favoriteId} {

      allow read:
        if request.auth != null
        && request.auth.uid == userId;


      allow create, update:
        if request.auth != null
        && request.auth.uid == userId

        && request.resource.data.listingId is string
        && request.resource.data.title is string
        && request.resource.data.location is string
        && request.resource.data.details is string
        && request.resource.data.price is number
        && request.resource.data.rating is number
        && request.resource.data.image is string;


      allow delete:
        if request.auth != null
        && request.auth.uid == userId;
    }


    /*
     * =========================================
     * DEMANDES DE RÉSERVATION
     * =========================================
     */
    match /bookingRequests/{requestId} {

      allow create:
        if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.listingId is string
        && request.resource.data.ownerName is string
        && request.resource.data.arrivalDate is string
        && request.resource.data.departureDate is string
        && request.resource.data.message is string;


      /*
       * Lecture par le demandeur
       * ou par l'annonceur concerné.
       */
      allow read:
        if request.auth != null
        && (
          resource.data.requesterId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );


      allow update, delete:
        if false;
    }


    /*
     * =========================================
     * LOGEMENTS / ANNONCES
     * =========================================
     *
     * - tout le monde peut lire les annonces
     * - l'annonceur gère uniquement
     *   ses propres annonces
     */
    match /listings/{listingId} {

      allow read:
        if true;

      /*
       * L'annonceur crée uniquement
       * des annonces à son nom.
       */
      allow create:
        if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;


      /*
       * L'annonceur peut modifier (pause,
       * remise en ligne) ou supprimer
       * ses propres annonces.
       */
      allow update:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete:
        if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }


    /*
     * =========================================
     * TOUT LE RESTE INTERDIT
     * =========================================
     */
    match /{document=**} {

      allow read, write:
        if false;
    }

  }

}